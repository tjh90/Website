# Copy to build/.env and fill in. build/.env is git-ignored.

# Public domain name the site is served on (DNS must point at this host; ports 80/443 open).
SITE_DOMAIN=example.com

# Required: contact email for the Let's Encrypt account.
LETSENCRYPT_EMAIL=you@example.com

# Optional: use the Let's Encrypt staging CA for trial deployments to avoid rate limits.
# LETSENCRYPT_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# Optional: source revision shown on the About page; usually passed as a build argument:
#   WEBSITE_REVISION=$(git rev-parse HEAD) docker compose -f build/compose.yml up -d --build
WEBSITE_REVISION=
